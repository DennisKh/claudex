data: {"type":"content_block_start","index":1,"content_block":{"type":"mcp_tool_result","tool_use_id":"mcptoolu_01PHt9BDJVXy8f1XPn92dKTn","is_error":false,"content":[{"type":"text","text":"Available pages for elixir-lang/elixir:\n\n- 1 Elixir Overview\n- 2 Core Language\n  - 2.1 Kernel and Macros\n  - 2.2 Module System and Compilation\n  - 2.3 Tokenization and Parsing\n  - 2.4 AST Expansion and Static Analysis\n  - 2.5 Code Module and Dynamic Evaluation\n  - 2.6 Type System\n- 3 Standard Library\n  - 3.1 Enumerable Protocol and Collections\n  - 3.2 Calendar and DateTime\n  - 3.3 Strings, Binaries, and Data Structures\n  - 3.4 Protocols and Typespecs\n  - 3.5 Exceptions and Error Handling\n- 4 OTP and Concurrency\n  - 4.1 GenServer, Agent, and Task\n  - 4.2 Supervisors and Supervision Trees\n  - 4.3 Application, Registry, and System\n- 5 Developer Tools\n  - 5.1 Interactive Elixir (IEx)\n  - 5.2 Mix Build System\n  - 5.3 Mix Format and Project Generation\n  - 5.4 Mix Releases and Deployment\n  - 5.5 ExUnit Testing Framework\n  - 5.6 Logger\n  - 5.7 EEx Templating Engine\n- 6 CLI and Bootstrapping\n  - 6.1 Kernel.CLI and Shell Scripts\n  - 6.2 Versioning and Compatibility\n- 7 Anti-Patterns and Best Practices\n  - 7.1 Code and Design Anti-Patterns\n  - 7.2 Macro and Process Anti-Patterns\n- 8 Glossary"}]}           }

